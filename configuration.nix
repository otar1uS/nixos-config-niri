# NixOS configuration for "nixos" (ThinkPad T14s Gen 3).
#
# Apply changes:  rebuild   (short for: sudo nixos-rebuild switch --flake ~/nixos-config#nixos)
#                 Always use the --flake form: plain `sudo nixos-rebuild switch`
#                 doesn't know that your config lives in ~/nixos-config.
# Undo the last:  sudo nixos-rebuild switch --rollback
# Find packages:  https://search.nixos.org  (Packages tab)
# Find settings:  https://search.nixos.org  (Options tab)  <- the important one
#
# Everything below is grouped and commented. Any block can be deleted.

{ config, pkgs, ... }:

{
  imports = [
    ./hardware-configuration.nix # disks + LUKS, generated by the installer
    ./modules/unstable.nix # which parts come from the unstable channel (newest versions)
    ./modules/niri.nix # the desktop: niri, login screen, fonts, desktop services
    ./modules/battery.nix # battery charging modes (Desk / Daily / Travel)
    ./modules/thinkpad.nix # fan modes, lid-logo LED, temperatures (the `thinkpad` command)
    ./modules/backup.nix # automatic encrypted backups (prepared, off until you pick a destination)
  ];

  # ─────────────────────────────────────────────────────────────────────────
  #  Boot
  # ─────────────────────────────────────────────────────────────────────────
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;

  # Every rebuild adds a boot entry. Your EFI partition is only 1 GB, and each
  # entry costs ~40 MB, so cap it. 10 is plenty to roll back through.
  boot.loader.systemd-boot.configurationLimit = 10;

  # ─────────────────────────────────────────────────────────────────────────
  #  Swap: compressed, in RAM (you have no swap partition)
  # ─────────────────────────────────────────────────────────────────────────
  # zram is a swap device that lives in RAM and compresses what it stores
  # (~2-3x), so 16 GB of RAM behaves closer to 20-24 GB under pressure. It
  # does NOT reserve memory up front; it only grows when swap is actually
  # needed. Check it any time with:  zramctl
  #
  # Trade-off: with no swap on disk, hibernate (suspend-to-disk) is not
  # possible. Normal suspend/sleep is unaffected.
  zramSwap = {
    enable = true;
    algorithm = "zstd"; # best ratio/speed balance
    memoryPercent = 50; # zram may hold up to 50% of RAM, compressed
  };

  # Swapping to RAM is cheap, so let the kernel do it eagerly (default is 60).
  boot.kernel.sysctl."vm.swappiness" = 100;

  # Editors, dev servers and file watchers run out of inotify handles fast.
  boot.kernel.sysctl."fs.inotify.max_user_watches" = 524288;

  # ─────────────────────────────────────────────────────────────────────────
  #  Nix itself
  # ─────────────────────────────────────────────────────────────────────────
  nix.settings = {
    # Turns on the modern `nix` commands: `nix develop`, `nix shell`, `nix run`,
    # `nix flake`. This does NOT convert this file into a flake - it only makes
    # the newer command line available. See the notes at the bottom.
    experimental-features = [
      "nix-command"
      "flakes"
    ];

    # Keep build inputs of dev shells so garbage collection does not delete
    # your per-project toolchains and force a re-download. Needed by direnv.
    keep-outputs = true;
    keep-derivations = true;
  };

  # The Nix store grows forever unless told otherwise. nh (a friendlier
  # front end for NixOS commands) cleans it once a week. Smarter than the
  # old `nix.gc` that was here: it always KEEPS your last 10 system
  # versions (so you can always roll back), plus anything from the last
  # 14 days, and deletes the rest.
  # `flake` tells nh where your config lives, so `nh os switch` needs no path.
  programs.nh = {
    enable = true;
    flake = "/home/otari/nixos-config";
    clean = {
      enable = true;
      dates = "weekly";
      extraArgs = "--keep 10 --keep-since 14d";
    };
  };

  # De-duplicates identical files in the store by hard-linking them. Saves a
  # surprising amount of disk; runs on a timer so it never slows a build.
  nix.optimise.automatic = true;

  # Needed for VS Code, Spotify, Chrome and other non-open-source packages.
  nixpkgs.config.allowUnfree = true;

  # ─────────────────────────────────────────────────────────────────────────
  #  Networking
  # ─────────────────────────────────────────────────────────────────────────
  networking.hostName = "nixos";
  networking.networkmanager.enable = true;

  # ─────────────────────────────────────────────────────────────────────────
  #  Locale and time
  # ─────────────────────────────────────────────────────────────────────────
  time.timeZone = "Asia/Tbilisi";
  i18n.defaultLocale = "en_US.UTF-8";
  i18n.extraLocaleSettings = {
    LC_ADDRESS = "ka_GE.UTF-8";
    LC_IDENTIFICATION = "ka_GE.UTF-8";
    LC_MEASUREMENT = "ka_GE.UTF-8";
    LC_MONETARY = "ka_GE.UTF-8";
    LC_NAME = "ka_GE.UTF-8";
    LC_NUMERIC = "ka_GE.UTF-8";
    LC_PAPER = "ka_GE.UTF-8";
    LC_TELEPHONE = "ka_GE.UTF-8";
    LC_TIME = "ka_GE.UTF-8";
  };

  # ─────────────────────────────────────────────────────────────────────────
  #  Desktop: niri on Wayland
  # ─────────────────────────────────────────────────────────────────────────
  # The whole desktop (niri, the login screen, fonts, battery and power
  # services) is set up in ./modules/niri.nix, imported at the top of this
  # file. The keyboard layouts (English + Georgian) are set in
  # home/niri/kdl/input.kdl.

  # Make Electron/Chromium apps (VS Code, Chrome, Discord, Slack) run as real
  # Wayland clients instead of through XWayland: sharper text, proper scaling.
  environment.sessionVariables.NIXOS_OZONE_WL = "1";

  # ─────────────────────────────────────────────────────────────────────────
  #  Hardware
  # ─────────────────────────────────────────────────────────────────────────
  hardware.bluetooth = {
    enable = true;
    powerOnBoot = true;
  };

  services.printing.enable = true;

  # Firmware updates (BIOS, Thunderbolt, fingerprint reader...) from Lenovo
  # via the LVFS service. Check for updates with:
  #   fwupdmgr refresh && fwupdmgr get-updates
  services.fwupd.enable = true;

  # Sound: PipeWire, with PulseAudio/ALSA apps working unchanged.
  services.pulseaudio.enable = false;
  security.rtkit.enable = true;
  services.pipewire = {
    enable = true;
    alsa.enable = true;
    alsa.support32Bit = true;
    pulse.enable = true;

    # PipeWire also handles cameras. Two fixes so camera apps (Camera,
    # Firefox, Discord...) only see your real webcam, once:
    wireplumber.extraConfig."10-webcam-v4l2-only" = {
      # 1. It found the webcam twice: through "v4l2" (the normal way for USB
      #    webcams) and through "libcamera" (only needed for Intel's MIPI
      #    laptop cameras). Turning libcamera off removes the duplicates.
      "wireplumber.profiles".main."monitor.libcamera" = "disabled";

      # 2. Your camera module also has an INFRARED camera (greyscale,
      #    640x360, made for Windows Hello face login). Apps listed it as a
      #    second "Integrated RGB Camera", and picking it by mistake gives a
      #    grainy grey picture. Hide it. It's matched by its fixed internal
      #    USB connection ("usb-0_1_1.2" = interface 2 of the built-in camera),
      #    which never changes, unlike /dev/video numbers.
      "monitor.v4l2.rules" = [
        {
          matches = [ { "node.name" = "v4l2_input.pci-0000_34_00.0-usb-0_1_1.2"; } ];
          actions.update-props."node.disabled" = true;
        }
      ];
    };
  };

  # ─────────────────────────────────────────────────────────────────────────
  #  Programs that need more than a package
  # ─────────────────────────────────────────────────────────────────────────
  programs.firefox.enable = true;

  programs.neovim = {
    enable = true;
    defaultEditor = true; # $EDITOR = nvim
    viAlias = true; # `vi`  -> nvim
    vimAlias = true; # `vim` -> nvim
  };

  # direnv loads a per-project environment when you `cd` into the folder.
  # This is the single most useful NixOS feature for development - see the
  # notes at the bottom of this file. nix-direnv is included automatically.
  programs.direnv.enable = true;

  # Lets downloaded binaries that expect a normal Linux run on NixOS. Without
  # this, many VS Code extensions and language servers fail with
  # "cannot find libstdc++" or similar, because NixOS has no /usr/lib.
  programs.nix-ld.enable = true;

  # comma: run any program without installing it, e.g.  `, cowsay hello`
  # And when you type a command you don't have, the terminal says which
  # package has it. Both use the ready-made index from the flake input
  # `nix-index-database` (updated by `upgrade`).
  programs.nix-index-database.comma.enable = true;
  programs.nix-index.enable = true; # the "command not found -> package" hints
  programs.command-not-found.enable = false; # the old version of those hints; it doesn't work with flakes

  # ─────────────────────────────────────────────────────────────────────────
  #  Containers
  # ─────────────────────────────────────────────────────────────────────────
  # NOTE: members of the "docker" group can start a container that mounts the
  # whole filesystem as root. That is normal for Docker, but it does mean the
  # group is effectively root access. Remove the group below if you would
  # rather type `sudo docker`.
  virtualisation.docker.enable = true;

  # ─────────────────────────────────────────────────────────────────────────
  #  Your user
  # ─────────────────────────────────────────────────────────────────────────
  users.users."otari" = {
    isNormalUser = true;
    description = "Otari Pkhovelishvili";
    extraGroups = [
      "networkmanager"
      "wheel" # sudo
     
    ];
    # Your own apps are listed in home.nix (home.packages).
  };

  # ─────────────────────────────────────────────────────────────────────────
  #  System packages
  # ─────────────────────────────────────────────────────────────────────────
  # Rule of thumb: put general tools here. Put PROJECT-specific versions
  # (Node 18 for one repo, Node 24 for another) in that project's dev shell
  # instead - see the notes at the bottom.
  environment.systemPackages = with pkgs; [
    wl-clipboard 
    # ── the basics a fresh install lacks ──
    git
    wget
    curl
    unzip
    zip
    tree
    file
    htop
    btop # nicer system monitor
    ripgrep # `rg`, a very fast grep
    fd # a friendlier `find`
    fzf # fuzzy finder
    jq # JSON on the command line
    yq-go # the same for YAML
    bat # `cat` with syntax highlighting
    eza # `ls` with colours and git status
    zoxide # smarter `cd`
    tmux

    # ── editors ──
    vscode
    # neovim is configured above, not listed here

    # ── git ──
    gh # GitHub CLI: `gh auth login`, `gh pr create`
    lazygit # git TUI

    # ── JavaScript / TypeScript ──
    nodejs_24
    pnpm
    bun
    typescript

    # ── Python ──
    python313
    uv # fast installer + venv manager; replaces pip/pipx/poetry
    ruff # linter + formatter

    # ── other languages ──
    go
    rustup # run `rustup default stable` once after install
    gcc
    gnumake

    # ── containers ──
    docker-compose
    lazydocker # docker TUI

    # ── Kubernetes ──
    kubectl
    kubernetes-helm
    k9s # cluster TUI
    kubectx # switch context/namespace
    kind # local clusters in Docker

    # ── infrastructure as code ──
    opentofu # the open fork of Terraform; binary is `tofu`
    ansible

    # ── databases ──
    postgresql # client tools (psql); the SERVER is services.postgresql
    pgcli # psql with autocomplete
    sqlite
    redis

    # ── HTTP / APIs ──
    xh # fast HTTPie-style client
    curlie

    # ── secrets ──
    sops
    age

    # ── working on this config ──
    nixfmt # formatter: `nixfmt configuration.nix`
    nil # Nix language server for VS Code / nvim
    nix-output-monitor # prettier build output: `nom`
    # (nh is installed by `programs.nh` above)

    # ── cloud CLIs: uncomment the one you use (each is large) ──
    # awscli2
    # azure-cli
    # google-cloud-sdk
  ];

  # ─────────────────────────────────────────────────────────────────────────
  #  Do not change this. It is the release this machine was installed with.
  # ─────────────────────────────────────────────────────────────────────────
  system.stateVersion = "26.05";
}
