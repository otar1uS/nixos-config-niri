// ═══════════════════════════════════════════════════════════════════
//  animations.kdl  —  how things move
// ═══════════════════════════════════════════════════════════════════
//  niri's default animations are already smooth. These make them feel
//  a little snappier with a tiny "springy" bounce.
//
//  Two kinds of animation:
//   - duration + curve: plays for a fixed time (in ms)
//   - spring: behaves like a physical spring. damping-ratio below 1.0
//     gives a small bounce, 1.0 = no bounce. Higher stiffness = faster.

animations {
    // Make EVERYTHING slower (2.0) or faster (0.5). 1.0 = normal.
    // Great for testing: set 5.0 to see each animation in slow motion.
    slowdown 1.0

    // A window appearing: quick start, gentle stop.
    window-open {
        duration-ms 200
        curve "ease-out-expo"
    }

    // A window closing: short and quiet.
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    // Switching workspaces (up/down): spring with a hint of bounce.
    workspace-switch {
        spring damping-ratio=0.9 stiffness=800 epsilon=0.0001
    }

    // Scrolling left/right along your windows.
    horizontal-view-movement {
        spring damping-ratio=0.9 stiffness=800 epsilon=0.0001
    }

    // Windows sliding into a new position.
    window-movement {
        spring damping-ratio=0.9 stiffness=800 epsilon=0.0001
    }
}
