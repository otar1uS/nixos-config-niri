// ═══════════════════════════════════════════════════════════════════
//  startup.kdl  —  things that happen when you log in to niri
// ═══════════════════════════════════════════════════════════════════
//  In .kdl files, a line starting with // is a comment. niri ignores it.
//  Each `spawn-at-startup` line starts ONE program, once, at login.

// Noctalia = your whole "desktop shell" in one program: top bar, app
// launcher, notifications, lock screen, wallpaper, volume/brightness
// pop-ups, clipboard history, control center, Alt+Tab switcher, and the
// password pop-up for admin actions. (Settings: home/noctalia/default.nix)
// It replaces three helpers the old version needed: a separate password
// pop-up (polkit-gnome) and two clipboard watchers (wl-paste + cliphist).
spawn-at-startup "noctalia"

// Ask apps NOT to draw their own title bars. Windows look cleaner,
// and you close/move them with shortcuts anyway.
prefer-no-csd

// Where screenshots are saved. They are ALSO copied to the clipboard,
// so you can paste them straight into Discord or Claude Code.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// niri can show a shortcut cheat sheet at every login. We turn that off.
// You can open it any time with Super+Shift+/ .
hotkey-overlay {
    skip-at-startup
}

// Lets Noctalia bring a window to the front when you click a notification
// (recommended by Noctalia's niri guide).
debug {
    honor-xdg-activation-with-invalid-serial
}
