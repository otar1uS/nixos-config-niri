// polkit decides who may do admin things. This says: a user in the "wheel"
// group (you), sitting at this laptop, may START the battery, fan and LED
// mode jobs without a password. Nothing else.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("verb") == "start" &&
      /^(battery-charge|thinkpad-set)@[a-z-]+\.service$/.test(action.lookup("unit")) &&
      subject.isInGroup("wheel") && subject.local && subject.active) {
    return polkit.Result.YES;
  }
});
