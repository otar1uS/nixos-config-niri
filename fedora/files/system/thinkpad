#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  thinkpad  —  fan modes, the lid-logo LED, and temperatures
# ═══════════════════════════════════════════════════════════════════════════
#
#  FAN MODES (safe ones only: never slower than the laptop would choose):
#    auto     the laptop decides (quiet, the factory behaviour)
#    charger  full speed while the charger is plugged in, auto on battery
#    max      full speed all the time
#
#  LID LED (the red dot on the "i" of the ThinkPad logo on the lid):
#    off / on / charging (lit only while the battery is charging)
#
#    thinkpad                show temperatures, fan and LED
#    thinkpad fan charger    pick a fan mode (no password needed)
#    thinkpad led charging   pick an LED mode
#
#  Choices are remembered in /var/lib/thinkpad/ and put back after a reboot,
#  after waking from sleep, and when the charger is plugged in or out.

set -euo pipefail

FAN=/proc/acpi/ibm/fan # from the thinkpad_acpi driver
LED="/sys/class/leds/tpacpi::lid_logo_dot"
STATE=/var/lib/thinkpad
FAN_MODES="auto charger max"
LED_MODES="off on charging"

# Temperature of the first sensor called NAME. Linux numbers the sensors
# (hwmon0, hwmon1...) differently on each boot, so look them up by name.
temp() {
  local h
  for h in /sys/class/hwmon/hwmon*; do
    if [ "$(cat "$h/name" 2>/dev/null)" = "$1" ]; then
      echo "$(($(cat "$h/temp1_input") / 1000)) °C"
      return
    fi
  done
  echo "-"
}

# Set the fan and LED to match the remembered modes (as root).
apply() {
  local fan led plugged level
  fan=$(cat $STATE/fan 2>/dev/null || echo auto)
  led=$(cat $STATE/led 2>/dev/null || echo "")
  plugged=$(cat /sys/class/power_supply/AC/online 2>/dev/null || echo 0)

  # Level 7 = the fastest *regulated* speed. Never "disengaged" (the kernel
  # docs warn it can exceed the fan's limits) and never low levels.
  case "$fan" in
    max) level=7 ;;
    charger) if [ "$plugged" = 1 ]; then level=7; else level=auto; fi ;;
    *) level=auto ;;
  esac
  echo "level $level" >$FAN 2>/dev/null ||
    echo "fan control is off: reboot once after installing (thinkpad_acpi fan_control=1)" >&2

  # The LED is only touched once you've picked a mode.
  case "$led" in
    off) echo none >"$LED/trigger"; echo 0 >"$LED/brightness" ;;
    on) echo none >"$LED/trigger"; echo 255 >"$LED/brightness" ;;
    charging) echo BAT0-charging >"$LED/trigger" ;;
  esac
}

case "${1:-status}" in
  status)
    echo "CPU   $(temp k10temp)"
    echo "GPU   $(temp amdgpu)"
    echo "SSD   $(temp nvme)"
    echo "WiFi  $(temp mt7921_phy0)"
    echo "Fan   $(sed -n 's/^speed:[[:space:]]*//p' $FAN) rpm, level $(sed -n 's/^level:[[:space:]]*//p' $FAN)," \
      "mode $(cat $STATE/fan 2>/dev/null || echo auto)"
    echo "LED   $(cat $STATE/led 2>/dev/null || echo "not set")"
    ;;

  fan | led)
    if [ "$1" = fan ]; then allowed=$FAN_MODES; else allowed=$LED_MODES; fi
    if [[ " $allowed " == *" ${2:-} "* ]]; then
      systemctl start "thinkpad-set@$1-$2.service"
    else
      echo "usage: thinkpad $1 [${allowed// / | }]" >&2
      exit 1
    fi
    ;;

  --set) # as root, from thinkpad-set@<kind>-<mode>.service
    kind=${2%%-*} mode=${2#*-}
    case "$kind:$mode" in
      fan:auto | fan:charger | fan:max | led:off | led:on | led:charging) ;;
      *) echo "unknown setting: ${2:-}" >&2; exit 1 ;;
    esac
    echo "$mode" >"$STATE/$kind"
    apply
    ;;

  --apply) # as root, at boot / wake / charger change (thinkpad-apply.service)
    apply
    ;;

  *)
    echo "usage: thinkpad [status | fan <mode> | led <mode>]" >&2
    exit 1
    ;;
esac
